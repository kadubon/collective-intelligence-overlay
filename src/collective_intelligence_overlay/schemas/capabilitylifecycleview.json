{
  "$defs": {
    "CapabilityIdentity": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Issuer",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "binding_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Binding Digest"
        }
      },
      "required": [
        "issuer",
        "subject",
        "binding_digest"
      ],
      "title": "CapabilityIdentity",
      "type": "object"
    },
    "ContributionObservation": {
      "additionalProperties": false,
      "properties": {
        "view_schema_version": {
          "const": "1",
          "default": "1",
          "title": "View Schema Version",
          "type": "string"
        },
        "derivation_version": {
          "const": "0.5.0",
          "default": "0.5.0",
          "title": "Derivation Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ObservationContext"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceObservation"
          },
          "maxItems": 256,
          "title": "Sources",
          "type": "array"
        },
        "residuals": {
          "items": {
            "$ref": "#/$defs/Residual"
          },
          "maxItems": 1024,
          "title": "Residuals",
          "type": "array"
        },
        "non_claims": {
          "default": [
            "No semantic truth, functional novelty, causal contribution or intelligence growth claim.",
            "Historical signature/PASS/ACCEPT, coverage and reception grant no current execution authority.",
            "Local bounded observations are not complete world history; missing costs are not zero."
          ],
          "items": {
            "type": "string"
          },
          "title": "Non Claims",
          "type": "array"
        },
        "observation_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "resulting_capability": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_capability": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/ContributionRelation"
          },
          "title": "Relations",
          "type": "array"
        },
        "strength": {
          "enum": [
            "declared",
            "observed",
            "unresolved"
          ],
          "title": "Strength",
          "type": "string"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "receiver": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receiver"
        },
        "transport": {
          "anyOf": [
            {
              "enum": [
                "local",
                "mcp",
                "a2a"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport"
        },
        "invocation_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Id"
        },
        "observed_outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Outcome"
        },
        "cost_refs": {
          "items": {
            "$ref": "#/$defs/CostReference"
          },
          "maxItems": 64,
          "title": "Cost Refs",
          "type": "array"
        },
        "receipt_links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "maxItems": 64,
          "title": "Receipt Links",
          "type": "array"
        },
        "unavailable_receipt_links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReceiptRef"
          },
          "maxItems": 64,
          "title": "Unavailable Receipt Links",
          "type": "array"
        },
        "functional_novelty": {
          "const": "unknown",
          "default": "unknown",
          "title": "Functional Novelty",
          "type": "string"
        },
        "local_installation": {
          "const": "unobserved",
          "default": "unobserved",
          "title": "Local Installation",
          "type": "string"
        }
      },
      "required": [
        "context",
        "sources",
        "residuals",
        "observation_id",
        "resulting_capability",
        "source_capability",
        "relations",
        "strength",
        "basis",
        "receiver",
        "cost_refs"
      ],
      "title": "ContributionObservation",
      "type": "object"
    },
    "ContributionRelation": {
      "enum": [
        "COPY",
        "IMPORT",
        "REUSE",
        "FORMATION_INPUT",
        "NEW_CANDIDATE"
      ],
      "title": "ContributionRelation",
      "type": "string"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "enum": [
            "formation",
            "verification",
            "transfer",
            "use",
            "maintenance",
            "revocation",
            "failure",
            "connection",
            "observation",
            "repair",
            "overhead"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "estimated",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,15}|(?=[\\d.]{1,25}0*$)\\d{0,15}\\.\\d{0,9}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "unit": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "category",
        "status",
        "quantity",
        "unit"
      ],
      "title": "Cost",
      "type": "object"
    },
    "CostObservation": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/CostReference"
        },
        "owner": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Owner",
          "type": "string"
        },
        "cost": {
          "$ref": "#/$defs/Cost"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Occurred At"
        },
        "duration_basis": {
          "enum": [
            "inclusive_or_unspecified",
            "recorded_quantity"
          ],
          "title": "Duration Basis",
          "type": "string"
        },
        "physical_cost_correspondence": {
          "const": "unresolved",
          "default": "unresolved",
          "title": "Physical Cost Correspondence",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "owner",
        "cost",
        "occurred_at",
        "duration_basis"
      ],
      "title": "CostObservation",
      "type": "object"
    },
    "CostReference": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/RecordRef"
        },
        "position": {
          "maximum": 63,
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "position"
      ],
      "title": "CostReference",
      "type": "object"
    },
    "CostSubtotal": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Owner",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "unit": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "estimated"
          ],
          "title": "Status",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "basis": {
          "const": "known_recorded_subtotal_not_complete_consumption",
          "default": "known_recorded_subtotal_not_complete_consumption",
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "category",
        "unit",
        "status",
        "quantity",
        "observation_count"
      ],
      "title": "CostSubtotal",
      "type": "object"
    },
    "Coverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "inconsistent"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/UseRequest"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "policy_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "record_count": {
          "default": 0,
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "revisions": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 2048,
          "title": "Revisions",
          "type": "object"
        },
        "source_observations": {
          "additionalProperties": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 4096,
          "title": "Source Observations",
          "type": "object"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "request",
        "outcome",
        "reasons",
        "policy_digest"
      ],
      "title": "Decision",
      "type": "object"
    },
    "ExecutionObservation": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/RecordRef"
        },
        "receipt": {
          "$ref": "#/$defs/ExecutionReceipt"
        }
      },
      "required": [
        "source",
        "receipt"
      ],
      "title": "ExecutionObservation",
      "type": "object"
    },
    "ExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "purpose": {
          "default": "reuse",
          "enum": [
            "reuse",
            "verification"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "invocation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Invocation Id",
          "type": "string"
        },
        "caller": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Caller",
          "type": "string"
        },
        "resource_owner": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Resource Owner",
          "type": "string"
        },
        "capability_issuer": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Capability Issuer",
          "type": "string"
        },
        "binding_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binding Digest",
          "type": "string"
        },
        "arguments_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Arguments Digest",
          "type": "string"
        },
        "result_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Digest"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "policy_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "state": {
          "enum": [
            "completed",
            "unknown",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "transport": {
          "enum": [
            "local",
            "mcp",
            "a2a"
          ],
          "title": "Transport",
          "type": "string"
        },
        "parent_invocation": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Invocation"
        }
      },
      "required": [
        "invocation_id",
        "caller",
        "resource_owner",
        "capability_issuer",
        "binding_digest",
        "arguments_digest",
        "scope",
        "policy_digest",
        "state",
        "transport"
      ],
      "title": "ExecutionReceipt",
      "type": "object"
    },
    "ObservationContext": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Owner",
          "type": "string"
        },
        "receiver": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receiver"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Digest"
        },
        "cutoff": {
          "format": "date-time",
          "title": "Cutoff",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "feed_generation": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Feed Generation"
        },
        "prefix": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prefix"
        },
        "revisions": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 2048,
          "title": "Revisions",
          "type": "object"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "coverage_basis": {
          "title": "Coverage Basis",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "record_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "record_limit": {
          "default": 256,
          "maximum": 256,
          "minimum": 1,
          "title": "Record Limit",
          "type": "integer"
        },
        "byte_limit": {
          "default": 1048576,
          "maximum": 1048576,
          "minimum": 1024,
          "title": "Byte Limit",
          "type": "integer"
        },
        "period_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Start"
        },
        "period_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period End"
        }
      },
      "required": [
        "owner",
        "receiver",
        "scope",
        "policy_digest",
        "cutoff",
        "observed_at",
        "feed_generation",
        "prefix",
        "coverage",
        "coverage_basis"
      ],
      "title": "ObservationContext",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "ACCEPT",
        "REQUALIFY",
        "REJECT",
        "UNKNOWN"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "ReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "issuer": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Issuer",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "id"
      ],
      "title": "ReceiptRef",
      "type": "object"
    },
    "RecordCursor": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Owner",
          "type": "string"
        },
        "generation": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Generation",
          "type": "string"
        },
        "query_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Query Digest",
          "type": "string"
        },
        "anchor": {
          "format": "date-time",
          "title": "Anchor",
          "type": "string"
        },
        "after": {
          "minimum": 0,
          "title": "After",
          "type": "integer"
        },
        "upper": {
          "minimum": 0,
          "title": "Upper",
          "type": "integer"
        }
      },
      "required": [
        "owner",
        "generation",
        "query_digest",
        "anchor",
        "after",
        "upper"
      ],
      "title": "RecordCursor",
      "type": "object"
    },
    "RecordQuery": {
      "additionalProperties": false,
      "properties": {
        "kinds": {
          "default": [
            "capability",
            "evidence",
            "revocation",
            "event"
          ],
          "items": {
            "enum": [
              "capability",
              "evidence",
              "revocation",
              "event",
              "decision",
              "opportunity",
              "proposal"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Kinds",
          "type": "array"
        },
        "issuer": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "record_id": {
          "anyOf": [
            {
              "maxLength": 330,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:@/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
