{
  "$defs": {
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "enum": [
            "formation",
            "verification",
            "transfer",
            "use",
            "maintenance",
            "revocation",
            "failure",
            "connection",
            "observation",
            "repair",
            "overhead"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "estimated",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,15}|(?=[\\d.]{1,25}0*$)\\d{0,15}\\.\\d{0,9}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "unit": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "category",
        "status",
        "quantity",
        "unit"
      ],
      "title": "Cost",
      "type": "object"
    },
    "ExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "purpose": {
          "default": "reuse",
          "enum": [
            "reuse",
            "verification"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "invocation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Invocation Id",
          "type": "string"
        },
        "caller": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Caller",
          "type": "string"
        },
        "resource_owner": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Resource Owner",
          "type": "string"
        },
        "capability_issuer": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Capability Issuer",
          "type": "string"
        },
        "binding_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binding Digest",
          "type": "string"
        },
        "arguments_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Arguments Digest",
          "type": "string"
        },
        "result_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Digest"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "policy_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "state": {
          "enum": [
            "completed",
            "unknown",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "transport": {
          "enum": [
            "local",
            "mcp",
            "a2a"
          ],
          "title": "Transport",
          "type": "string"
        },
        "parent_invocation": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Invocation"
        }
      },
      "required": [
        "invocation_id",
        "caller",
        "resource_owner",
        "capability_issuer",
        "binding_digest",
        "arguments_digest",
        "scope",
        "policy_digest",
        "state",
        "transport"
      ],
      "title": "ExecutionReceipt",
      "type": "object"
    },
    "FormationReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "receipts": {
          "items": {
            "$ref": "#/$defs/ReceiptRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Receipts",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "binding_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binding Digest",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "observed-use",
            "declared"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "functional_novelty": {
          "const": "unknown",
          "default": "unknown",
          "title": "Functional Novelty",
          "type": "string"
        },
        "verification": {
          "const": "candidate",
          "default": "candidate",
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "receipts",
        "scope",
        "binding_digest",
        "policy_digest",
        "relationship"
      ],
      "title": "FormationReceipt",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "ACCEPT",
        "REQUALIFY",
        "REJECT",
        "UNKNOWN"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "ReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "issuer": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Issuer",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "id"
      ],
      "title": "ReceiptRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Exact operational applicability; schema equality does not prove semantic fit.",
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "task": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Task",
          "type": "string"
        },
        "input_contract": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Input Contract",
          "type": "string"
        },
        "output_contract": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Output Contract",
          "type": "string"
        },
        "environment": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-zA-Z0-9_.:/-]+$": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 160,
            "minLength": 1
          },
          "title": "Environment",
          "type": "object"
        },
        "permissions": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:/-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Permissions",
          "type": "array"
        }
      },
      "required": [
        "task",
        "input_contract",
        "output_contract",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "title": "Subject",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "WorkObservation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "receiver": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Receiver",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "policy_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "goal_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Goal Id",
          "type": "string"
        },
        "goal_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Goal Digest",
          "type": "string"
        },
        "opportunity_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opportunity Id"
        },
        "work_kind": {
          "anyOf": [
            {
              "enum": [
                "formation",
                "connection",
                "verification",
                "observation",
                "repair"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Kind"
        },
        "stage": {
          "enum": [
            "discovery",
            "selection",
            "allocation"
          ],
          "title": "Stage",
          "type": "string"
        },
        "result": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Result",
          "type": "string"
        },
        "proposals_received": {
          "anyOf": [
            {
              "maximum": 128,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposals Received"
        },
        "rule_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Digest"
        },
        "reasons": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:/-]+$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reasons",
          "type": "array"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        }
      },
      "required": [
        "receiver",
        "scope",
        "policy_digest",
        "goal_id",
        "goal_digest",
        "stage",
        "result"
      ],
      "title": "WorkObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1",
      "enum": [
        "1",
        "2",
        "3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "formation": {
      "anyOf": [
        {
          "$ref": "#/$defs/FormationReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "work": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "const": "event",
      "default": "event",
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Id",
      "type": "string"
    },
    "issuer": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Issuer",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "action": {
      "enum": [
        "proposal",
        "formation",
        "verification",
        "admission",
        "reuse",
        "composition",
        "revocation",
        "failure",
        "replication",
        "import",
        "recommendation"
      ],
      "title": "Action",
      "type": "string"
    },
    "task_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Task Id",
      "type": "string"
    },
    "attempt_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Attempt Id",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "costs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Cost"
      },
      "maxItems": 64,
      "title": "Costs",
      "type": "array"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "$ref": "#/$defs/Verdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    }
  },
  "required": [
    "issuer",
    "subject",
    "action",
    "task_id",
    "attempt_id",
    "correlation_id"
  ],
  "title": "Event",
  "type": "object"
}
