{
  "$defs": {
    "Scope": {
      "additionalProperties": false,
      "description": "Exact operational applicability; schema equality does not prove semantic fit.",
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "task": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Task",
          "type": "string"
        },
        "input_contract": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Input Contract",
          "type": "string"
        },
        "output_contract": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Output Contract",
          "type": "string"
        },
        "environment": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-zA-Z0-9_.:/-]+$": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:/-]+$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 160,
            "minLength": 1
          },
          "title": "Environment",
          "type": "object"
        },
        "permissions": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:/-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Permissions",
          "type": "array"
        }
      },
      "required": [
        "task",
        "input_contract",
        "output_contract",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "title": "Subject",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1",
      "enum": [
        "1",
        "2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "binding_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Binding Digest"
    },
    "kind": {
      "const": "evidence",
      "default": "evidence",
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Id",
      "type": "string"
    },
    "issuer": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Issuer",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "claim": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Claim",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "receivers": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:/-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Receivers",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "method": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Method",
      "type": "string"
    },
    "verifier_version": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Verifier Version",
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "sources": {
      "default": [],
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:/-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Sources",
      "type": "array"
    },
    "evidence_dependencies": {
      "default": [],
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:/-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Evidence Dependencies",
      "type": "array"
    },
    "objections": {
      "default": [],
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:/-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Objections",
      "type": "array"
    },
    "obligations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Obligations",
      "type": "array"
    },
    "declared_origin": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 32,
      "title": "Declared Origin",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "subject",
    "claim",
    "scope",
    "receivers",
    "verdict",
    "method",
    "verifier_version",
    "artifact_digest",
    "expires_at"
  ],
  "title": "Evidence",
  "type": "object"
}
